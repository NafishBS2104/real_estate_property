<odoo>
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties" decoration-success="state in ('offer_received','offer_accepted')"
                  decoration-bf="state=='offer_accepted'" decoration-muted="state=='sold'">
                <field name="name" string="Title"/>
                <field name="postcode"/>
                <field name="state"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field':'color'}"/>
                <field name="property_type_id" widget="many2one_tags"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability" string="Available From" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header invisible="state=='sold'">
                    <button name="action_sell" string="Sell" type="object"/>
                    <button name="action_cancel" string="Cancel" type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="state" widget="statusbar"
                                   statusbar_visible="new,offer_received,offer_accepted,sold,cancelled"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field':'color'}"/>
                            <field name="property_type_id" widget="many2one_tags"
                                   options="{'no_create':True, 'no_edit':True}"/>
                            <field name="postcode"/>
                            <field name="date_availability" string="Available From"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="best_price"/>
                        </group>
                        <notebook>
                            <page string="Description">
                                <group>
                                    <field name="description"/>
                                    <field name="bedrooms"/>
                                    <field name="living_area" string="Living Area"/>
                                    <field name="facades"/>
                                    <field name="garage"/>
                                    <field name="garden"/>
                                    <field name="garden_area" string="Garden Area m^2" invisible="garden==False"/>
                                    <field name="garden_orientation" invisible="garden==False"/>
                                    <field name="total_area" string="Total Area Sqm"/>
                                </group>
                            </page>
                            <page string="Financial Details">
                                <group>
                                    <field name="expected_price" string="I'm Expecting"/>
                                </group>
                            </page>
                            <page string="Buyer and Seller info">
                                <group>
                                    <field name="salesperson_id" string="Salesperson : "/>
                                    <field name="buyer_id" string="Buyer : "/>
                                </group>
                            </page>
                            <page string="Offers">
                                <group>
                                    <field name="offer_ids" readonly="state in ('sold','cancelled', 'offer_accepted')"/>
                                </group>
                            </page>
                        </notebook>
                    </group>
                </sheet>

                <sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search for">
                <field name="name" string="Title"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area" filter_domain="[('living_area', '>=', self)]"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="best_price"/>
                <field name="garden_area"/>
                <field name="date_availability" string="Available From"/>
                <separator/>
                <filter name="available" string="Available" domain="[('state','in',('new','offer_received'))]"/>
                <filter name="student_pack" string="Student Packs" domain="[('expected_price','&lt;',100000)]"/>
                <separator/>
                <group expand="1" string="Group By">
                    <filter name="postcode" string="Postcode" context="{'group_by':'postcode'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id" records_draggable="false">
                <field name="state"/>
                <field name="property_type_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div>
                            <field name="name"/>
                            <div>Expected Price :
                                <field name="expected_price"/>
                            </div>
                            <field name="tag_ids"/>
                            <div t-if="record.state.raw_value == 'offer_received'">
                                Best Price :
                                <field name="best_price" string="Best Price"/>
                            </div>
                            <div t-if="record.state.raw_value == 'offer_accepted'">
                                Selling Price :
                                <field name="selling_price" string="Selling Price"/>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_available':True}</field>
    </record>
</odoo>