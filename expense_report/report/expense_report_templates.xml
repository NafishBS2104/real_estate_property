<odoo>
    <template id="report_expense_report_details">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure">
                            <h2>Expense Report</h2>
                            <br/>
                            <p>
                                Name :
                                <span t-field="o.name"/>
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>