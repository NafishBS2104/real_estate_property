<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="attendance_dashboard.AttendanceDashboard">
        <div class="o_attendance_dashboard container mt-4">
            <h2 class="mb-4">
                Employee Attendance Dashboard
            </h2>

            <div class="mb-4">
                <input
                    type="text"
                    class="form-control"
                    placeholder="Search employee..."
                    t-model="state.search"
                />
            </div>


            <div class="row mb-4">
                <div class="col-lg-4">
                    <div class="card text-center shadow-sm">
                        <div class="card-body">
                            <h5> Total Employees </h5>
                            <h2>
                                <t t-esc="totalEmployees"/>
                            </h2>

                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card text-center shadow-sm">
                        <div class="card-body">
                            <h5>Total Worked Hours</h5>

                            <h2>
                                <t t-esc="totalHours"/>
                            </h2>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card text-center shadow-sm">
                        <div class="card-body">
                            <h5>Average Hours</h5>
                            <h2>
                                <t t-esc="averageHours"/>
                            </h2>
                        </div>
                    </div>
                </div>

            </div>

            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Employee</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Worked Hours</th>
                    </tr>
                </thead>

                <tbody>
                    <t t-if="filteredEmployees.length">
                        <tr
                            t-foreach="filteredEmployees"
                            t-as="employee"
                            t-key="employee.id"
                        >
                            <td>
                                <t t-esc="employee.name"/>
                            </td>

                            <td>
                                <t t-esc="employee.check_in"/>
                            </td>

                            <td>
                                <t t-esc="employee.check_out"/>
                            </td>
                            <td
                                t-att-class="getHoursClass(employee.hours)"
                            >
                                <t t-esc="employee.hours"/>
                            </td>
                        </tr>
                    </t>

                    <t t-else="">
                        <tr>
                            <td colspan="4" class="text-center text-muted">
                                No attendance records found.
                            </td>
                        </tr>
                    </t>
                </tbody>

            </table>
        </div>
    </t>
</templates>