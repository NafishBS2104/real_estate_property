<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="attendance_dashboard.AttendanceDashboard" owl="1">

        <t t-if="state.loading">
            <div class="text-center mt-6">
                <h3>Loading Attendence...</h3>
            </div>
        </t>

        <t t-elif="state.error">
            <div class="alert alert-danger m-4">
                Unable to load attendance records.
            </div>
        </t>

        <t t-else="">
            <div class="o_attendance_dashboard container mt-4">

                <h2 class="mb-4">
                    Employee Attendance Dashboard
                </h2>

                <div class="mb-4">
                    <input
                        type="text"
                        class="form-control"
                        placeholder="Search employee...."
                        t-model="state.search"
                        />
                </div>

                <div class="row mb-4">
                    <div class="col-lg-4">
                        <div class="card text-center shadow-sm">
                            <div class="card-body">
                                <h5>Total Employees</h5>

                                <h2>
                                    <t t-esc="totalEmployees"/>
                                </h2>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card text-center shadow-sm">
                            <div class="card-body">
                                <h5>Total Worked Hours</h5>
                                <h2>
                                    <t t-esc="totalHours.toFixed(2)"/>
                                </h2>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card text-center shadow-sm">
                            <div class="card-body">
                                <h5>Average Hours</h5>

                                <h2>
                                    <t t-esc="averageHours"/>
                                </h2>
                            </div>
                        </div>
                    </div>


                </div>

                <t t-if="filteredEmployees.length">
                    <div class="row">
                        <t
                            t-foreach="filteredEmployees"
                            t-as="employee"
                            t-key="employee.id"
                            >
                            <EmployeeCard employee="employee"/>
                        </t>
                    </div>
                </t>


                <t t-else="">
                    <div class="alert alert-info text-center">
                        No attendance records found.
                    </div>
                </t>
            </div>
        </t>
    </t>
</templates>